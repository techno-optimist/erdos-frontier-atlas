{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "atlas/ai_results.json",
 "type": "object",
 "required": [
  "schema",
  "purpose",
  "retrieved",
  "counts",
  "entries"
 ],
 "additionalProperties": false,
 "properties": {
  "schema": {
   "const": "efa-ai-results-v1"
  },
  "purpose": {
   "type": "string"
  },
  "retrieved": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "counts": {
   "type": "object",
   "required": [
    "entries",
    "ai_involvement_confirmed",
    "ai_involvement_unconfirmed"
   ],
   "additionalProperties": {
    "type": "integer"
   }
  },
  "entries": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "quantity",
     "prior",
     "new",
     "source_urls",
     "date",
     "date_basis",
     "attribution",
     "ai_involvement",
     "our_verdict",
     "status_changed_by_this_entry",
     "atlas_nodes"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^C-\\d+$"
     },
     "quantity": {
      "type": "string",
      "minLength": 1
     },
     "prior": {
      "type": "object",
      "required": [
       "value",
       "source"
      ],
      "additionalProperties": false,
      "properties": {
       "value": {
        "type": "string"
       },
       "source": {
        "type": "string"
       }
      }
     },
     "new": {
      "type": "object",
      "required": [
       "value"
      ],
      "additionalProperties": false,
      "properties": {
       "value": {
        "type": "string"
       }
      }
     },
     "source_urls": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "string",
       "pattern": "^https://\\S+$"
      }
     },
     "authors": {
      "type": "string"
     },
     "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
     },
     "date_basis": {
      "type": "string"
     },
     "attribution": {
      "enum": [
       "reported",
       "claimed"
      ]
     },
     "ai_involvement": {
      "type": "object",
      "required": [
       "status",
       "detail"
      ],
      "additionalProperties": false,
      "properties": {
       "status": {
        "enum": [
         "confirmed",
         "unconfirmed"
        ]
       },
       "detail": {
        "type": "string"
       }
      }
     },
     "our_verdict": {
      "const": "not independently checked"
     },
     "status_changed_by_this_entry": {
      "const": false
     },
     "atlas_nodes": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "note": {
      "type": "string"
     }
    }
   }
  }
 }
}
