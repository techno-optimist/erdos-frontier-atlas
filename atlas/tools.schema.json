{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "atlas/tools.json",
 "type": "object",
 "required": [
  "schema",
  "purpose",
  "retrieved",
  "counts",
  "items"
 ],
 "additionalProperties": false,
 "properties": {
  "schema": {
   "const": "efa-tools-v1"
  },
  "purpose": {
   "type": "string"
  },
  "retrieved": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "counts": {
   "type": "object",
   "required": [
    "items",
    "by_kind"
   ],
   "properties": {
    "items": {
     "type": "integer"
    },
    "by_kind": {
     "type": "object",
     "additionalProperties": {
      "type": "integer"
     }
    }
   }
  },
  "items": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "name",
     "kind",
     "org",
     "first_public_date",
     "date_basis",
     "primary_urls",
     "areas",
     "verification_mode",
     "atlas_nodes_touched"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^B-\\d+$"
     },
     "name": {
      "type": "string",
      "minLength": 1
     },
     "kind": {
      "enum": [
       "system",
       "benchmark",
       "registry",
       "dataset"
      ]
     },
     "org": {
      "type": "string",
      "minLength": 1
     },
     "first_public_date": {
      "type": "string",
      "pattern": "^\\d{4}(-\\d{2}-\\d{2})?$"
     },
     "date_basis": {
      "type": "string",
      "minLength": 1
     },
     "primary_urls": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "string",
       "pattern": "^https://\\S+$"
      }
     },
     "areas": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "string"
      }
     },
     "verification_mode": {
      "type": "string",
      "minLength": 1
     },
     "atlas_nodes_touched": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "note": {
      "type": "string"
     }
    }
   }
  }
 }
}
